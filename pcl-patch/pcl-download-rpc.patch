+    #region 自定义下载卡片（与「工具 → 百宝箱」共享同一份数据）
+
+    /// <summary>
+    ///     从共享状态恢复本卡片的输入内容，并刷新按钮可用性。
+    ///     首次加载与每次进入本页都会被调用，从而实现与百宝箱的双向同步。
+    /// </summary>
+    private void LaunchDownloadSyncFromState()
+    {
+        try
+        {
+            // 目录：优先用共享状态里已有的值，否则回落到 PCL 自己记住的位置
+            if (!string.IsNullOrEmpty(CustomDownloadState.Folder))
+            {
+                if (LaunchTextDownloadFolder.Text != CustomDownloadState.Folder)
+                    LaunchTextDownloadFolder.Text = CustomDownloadState.Folder;
+            }
+            else
+            {
+                var saved = States.Tool.DownloadFolder;
+                if (!string.IsNullOrEmpty(saved)) LaunchTextDownloadFolder.Text = saved;
+            }
+
+            LaunchTextDownloadFolder.Validate();
+            if (!string.IsNullOrEmpty(LaunchTextDownloadFolder.ValidateResult) ||
+                string.IsNullOrEmpty(LaunchTextDownloadFolder.Text))
+                LaunchTextDownloadFolder.Text = ModBase.exePath + @"PCL\MyDownload\";
+
+            // 先快照，避免下面写控件时（地址变化会自动推断文件名）把共享状态冲掉
+            var stateUrl = CustomDownloadState.Url;
+            var stateName = CustomDownloadState.FileName;
+
+            // 必须先写文件名再写地址：
+            // 地址的 TextChanged 在文件名为空时会自动从 URL 推断一个名字，
+            // 那会把正确的文件名和共享状态一起覆盖掉。
+            if (!string.IsNullOrEmpty(stateName) && LaunchTextDownloadName.Text != stateName)
+                LaunchTextDownloadName.Text = stateName;
+
+            if (!string.IsNullOrEmpty(stateUrl) && LaunchTextDownloadUrl.Text != stateUrl)
+                LaunchTextDownloadUrl.Text = stateUrl;
+
+            LaunchTextDownloadUrl.Validate();
+            LaunchTextDownloadName.Validate();
+            LaunchTextDownloadFolder.Validate();
+            LaunchDownloadButtonRefresh();
+        }
+        catch (Exception ex)
+        {
+            ModBase.Log(ex, "刷新主页自定义下载卡片失败");
+        }
+    }
+
+    private void LaunchDownloadButtonRefresh()
+    {
+        LaunchBtnDownloadStart.IsEnabled = string.IsNullOrEmpty(LaunchTextDownloadFolder.ValidateResult) &&
+                                           string.IsNullOrEmpty(LaunchTextDownloadUrl.ValidateResult) &&
+                                           string.IsNullOrEmpty(LaunchTextDownloadName.ValidateResult);
+        LaunchBtnDownloadOpen.IsEnabled = string.IsNullOrEmpty(LaunchTextDownloadFolder.ValidateResult);
+    }
+
+    private void LaunchDownloadUrl_TextChanged(object sender, TextChangedEventArgs e)
+    {
+        try
+        {
+            CustomDownloadState.Url = LaunchTextDownloadUrl.Text;
+            if (!string.IsNullOrEmpty(LaunchTextDownloadName.Text) ||
+                string.IsNullOrEmpty(LaunchTextDownloadUrl.Text)) return;
+            LaunchTextDownloadName.Text =
+                ModBase.GetFileNameFromPath(System.Net.WebUtility.UrlDecode(LaunchTextDownloadUrl.Text));
+            LaunchDownloadButtonRefresh();
+        }
+        catch
+        {
+        }
+    }
+
+    private void LaunchDownloadName_TextChanged(object sender, TextChangedEventArgs e)
+    {
+        CustomDownloadState.FileName = LaunchTextDownloadName.Text;
+    }
+
+    private void LaunchDownloadFolder_TextChanged(object sender, TextChangedEventArgs e)
+    {
+        CustomDownloadState.Folder = LaunchTextDownloadFolder.Text;
+    }
+
+    private void LaunchDownloadUrl_ValidateChanged(object sender, RoutedEventArgs e)
+    {
+        LaunchDownloadButtonRefresh();
+    }
+
+    private void LaunchDownloadName_ValidateChanged(object sender, RoutedEventArgs e)
+    {
+        LaunchDownloadButtonRefresh();
+    }
+
+    private void LaunchDownloadFolder_ValidateChanged(object sender, EventArgs e)
+    {
+        LaunchDownloadButtonRefresh();
+    }
+
+    private void LaunchDownloadFolder_OnValidatedTextChanged(object sender, RoutedEventArgs e)
+    {
+        // 与百宝箱同源：目录校验通过后写回 PCL 的持久化状态
+        States.Tool.DownloadFolder = LaunchTextDownloadFolder.Text;
+        CustomDownloadState.Folder = LaunchTextDownloadFolder.Text;
+        LaunchTextDownloadName.Validate();
+        LaunchDownloadButtonRefresh();
+    }
+
+    private void LaunchDownloadSelectFolder_Click(object sender, EventArgs e)
+    {
+        var text = SystemDialogs.SelectFolder();
+        if (!string.IsNullOrEmpty(text)) LaunchTextDownloadFolder.Text = text;
+    }
+
+    private void LaunchDownloadOpen_Click(object sender, MouseButtonEventArgs e)
+    {
+        try
+        {
+            var text = LaunchTextDownloadFolder.Text;
+            Directory.CreateDirectory(text);
+            Basics.OpenPath(text);
+        }
+        catch (Exception ex)
+        {
+            ModBase.Log(ex, "打开下载文件夹失败");
+        }
+    }
+
+    private void LaunchDownloadStart_Click(object sender, MouseButtonEventArgs e)
+    {
+        PageToolsTest.StartCustomDownload(LaunchTextDownloadUrl.Text, LaunchTextDownloadName.Text,
+            LaunchTextDownloadFolder.Text);
+
+        // 与百宝箱保持一致：启动后清空地址与文件名
+        LaunchTextDownloadUrl.Text = "";
+        LaunchTextDownloadUrl.Validate();
+        LaunchTextDownloadUrl.ForceShowAsSuccess();
+        LaunchTextDownloadName.Text = "";
+        LaunchTextDownloadName.Validate();
+        LaunchTextDownloadName.ForceShowAsSuccess();
+        CustomDownloadState.ClearRequest();
+        LaunchDownloadButtonRefresh();
+
+        // 跳去「任务管理」页看进度（与 PCL 自带的“下载中”按钮同一目标页）
+        try
+        {
+            ModMain.frmMain.PageChange(FormMain.PageType.TaskManager);
+        }
+        catch (Exception ex)
+        {
+            ModBase.Log(ex, "跳转到任务管理页失败");
+        }
+    }
+
+    #endregion
+
     #endregion
 }
