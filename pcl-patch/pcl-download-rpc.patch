+    /// <summary>
+    ///     解析浏览器接管传来的下载参数，写入共享状态。
+    ///     形如：--download &lt;url&gt; --filename &lt;name&gt; [--folder &lt;dir&gt;]
+    /// </summary>
+    private static void ApplyDownloadStartupArguments(string[] args)
+    {
+        string? url = null, name = null, folder = null;
+        for (var i = 0; i < args.Length - 1; i++)
+        {
+            switch (args[i])
+            {
+                case "--download":
+                    url = args[i + 1].Trim('"');
+                    break;
+                case "--filename":
+                    name = args[i + 1].Trim('"');
+                    break;
+                case "--folder":
+                    folder = args[i + 1].Trim('"');
+                    break;
+            }
+        }
+
+        if (string.IsNullOrWhiteSpace(url)) return;
+
+        CustomDownloadState.Url = url;
+        if (!string.IsNullOrWhiteSpace(name)) CustomDownloadState.FileName = name;
+        if (!string.IsNullOrWhiteSpace(folder)) CustomDownloadState.Folder = folder;
+        ModBase.Log($"[Start] 收到下载接管参数，将在主页预填：{name}");
+    }
+
