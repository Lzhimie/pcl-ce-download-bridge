{
  "manifest_version": 3,
  "name": "PCL CE 下载接管",
  "version": "0.5.0",
  "description": "拦截浏览器下载，交给你本机的 PCL CE 启动器用高速多线程引擎下载（类似 IDM 的接管体验）。",
  "minimum_chrome_version": "102",
  "permissions": [
    "downloads",
    "nativeMessaging",
    "storage",
    "tabs"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "PCL CE 下载接管",
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}